  "gong": {
    "arcDeg": 90,
    "wireDiaUnits": 1.0,
    "_comment": "The alarm gong's ringing wire. arcDeg is measured BACK FROM THE FREE (struck) end, so changing it moves the FOOT and leaves the hammer, its pivot and the strike point exactly where they are. Both feed the synthesised tone: f_n = (beta_n L)^2 (d/4) sqrt(E/rho) / (2 pi L^2) for a clamped-free steel bar, so the gong is heard at the pitch its dimensions imply rather than at a chosen note. Shorter arc or thicker wire = higher pitch. See TODO 17 — at the 90 deg default the fundamental is only 623 Hz, low for an alarm; ~45 deg puts it near 2.5 kHz.",
    "_bounds": {
      "arcDeg": [
        25,
        120
      ],
      "wireDiaUnits": [
        0.4,
        2.0
      ]
    },
    "_labels": {
      "arcDeg": "Gong arc (degrees)",
      "wireDiaUnits": "Gong wire diameter"
    }
  },
  "decoration": {
    "ribbing": {
      "widthUnits": 30,
      "angleDeg": 25,
      "tilt": 0.35,
      "_comment": "Glashuette stripes on the 3/4 plate + escape bridge. widthUnits = band pitch in model units, so LARGER means FEWER ribs — the default sits at the bound maximum, i.e. ribbing at its minimum (was 6.7); angleDeg = direction the bands PROGRESS in (stripes run perpendicular); tilt = normal scallop strength (0 = off). Stripes are computed from WORLD position in the shader, so they continue across separate parts by construction.",
      "_bounds": {
        "widthUnits": [
          2,
          30
        ],
        "tilt": [
          0,
          1
        ]
      },
      "_labels": {
        "widthUnits": "Rib pitch (fewer ribs →)",
        "angleDeg": "Rib angle",
        "tilt": "Rib scallop depth"
      }
    },
    "perlage": {
      "pitchUnits": 8.4,
      "ringFreq": 48.0,
      "tilt": 0.22,
      "_comment": "Circular graining on the BASE plate, stamped like the real thing: pearls in a staggered grid, each fragment shaded by the LAST pearl (row-major application order) whose radius covers it — so every pearl overlaps its neighbours in one direction, shingled. pearlRadiusUnits > pitch/2 sets the overlap.",
      "pearlRadiusUnits": 6.5,
      "shingleFlip": true,
      "jitterFrac": 0.12,
      "_bounds": {
        "pitchUnits": [
          2,
          30
        ],
        "tilt": [
          0,
          1
        ]
      },
      "_labels": {
